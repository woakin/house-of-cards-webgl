# Cloudflare Headers Configuration

# Global CORS
/*
  Access-Control-Allow-Origin: *

# Cache static binary chunks and audio files for 1 year immutable
/data/chunks/*.bin
  Cache-Control: public, max-age=31536000, immutable

/data/*.mp3
  Cache-Control: public, max-age=31536000, immutable

# Manifest file MUST revalidate immediately upon deploy
/data/chunks/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

# Cache static JS, CSS, images
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML documents & root path (never cache stale HTML)
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
